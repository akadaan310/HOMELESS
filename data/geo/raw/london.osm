 <node id="7817017136" visible="true" version="6" changeset="165892471" timestamp="2025-05-06T13:32:24Z" user="Cebderby" uid="705850" lat="51.5074062" lon="-0.1276915">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="On the site now occupied by the statue of King Charles I was erected the original Queen Eleanor's Cross, a replica of which stands in front of Charing Cross station. Mileages from London are measured from the site of the original cross."/>
  <tag k="material" v="metal"/>
  <tag k="memorial" v="plaque"/>
  <tag k="name" v="Mileage Central Point of London Plaque"/>
  <tag k="note" v="The Mileage Central Point Plaque does not mark the central point, it states that the adjacent Equestrian Statue of Charles I marks the official point from where distances to London are measured."/>
  <tag k="openplaques:id" v="11860"/>
  <tag k="plaque" v="information"/>
  <tag k="wikipedia" v="en:Kilometre zero#Great Britain"/>
 </node>
